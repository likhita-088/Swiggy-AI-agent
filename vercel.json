{
  "version": 2,
  "builds": [
    { "src": "api/chat.ts", "use": "@vercel/node" },
    { "src": "api/oauth-callback.ts", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/oauth-callback", "dest": "/api/oauth-callback.ts" },
    { "src": "/api/chat", "dest": "/api/chat.ts" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
